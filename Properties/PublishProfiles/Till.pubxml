<?xml version="1.0" encoding="utf-8"?>
<!--
  Install package for a till: dotnet publish empifisJsonService2.csproj -p:PublishProfile=Till
  Self-contained, so the .NET runtime ships in the folder and nothing has to be installed on the till.
  32-bit, because EmpiFisX.dll is a 32-bit COM server.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\publish\till\</PublishDir>
  </PropertyGroup>
</Project>
