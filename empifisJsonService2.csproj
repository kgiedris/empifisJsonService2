<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-empifisJsonService2-9decb414-8651-4939-9863-c36178ee3a9b</UserSecretsId>
    <!-- Enable Windows Forms so NotifyIcon and System.Drawing.Icon are available when running the console app on Windows -->
    <UseWindowsForms>true</UseWindowsForms>
  <Platforms>AnyCPU;x86</Platforms>
  <!-- Force 32-bit process so 32-bit COM servers can be loaded. -->
  <PlatformTarget>x86</PlatformTarget>
  <!-- Prefer32Bit is not supported for .NET 5+ (NETSDK1189); target the win-x86 RID instead. -->
  <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  <!-- Allow building/publishing for other RIDs if needed -->
  <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <Version>2.3.2</Version>
    <!-- Leave out the framework's translated resource files; keeps the install package smaller. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- A small single-device service: workstation GC uses far less memory on a till than server GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- No web.config on publish: it is only for hosting in IIS, and this runs as a Windows service. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Empirija">
        <HintPath>$(MSBuildProjectDirectory)\Interop.Empirija.dll</HintPath>
        <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.3" />
    <PackageReference Include="NLog.Extensions.Hosting" Version="6.0.3" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The test project (tests\) and the installer sources (installer\) are not part of the service. -->
    <Compile Remove="tests\**;installer\**" />
    <Content Remove="tests\**;installer\**" />
    <None Remove="tests\**;installer\**" />
    <EmbeddedResource Remove="tests\**;installer\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="empirija-logo.png" Condition="Exists('empirija-logo.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Install package extras: the service scripts and the manual go next to the exe on publish.
         The manual is published as empifisJSON_<version>.docx (e.g. empifisJSON_2_3_2.docx), so its name
         always matches the service version; in the repo it is plain empifisJSON.docx. -->
    <None Update="deploy\*.bat" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Update="empifisJSON.docx" Link="empifisJSON_$(Version.Replace('.', '_')).docx" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>